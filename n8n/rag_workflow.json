{
  "name": "RAG System Multi-Source QA Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/ask",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"question\": \"{{ $json.body.question || $json.question || $json.message || 'What courses does ZAIO offer?' }}\"\n}",
        "options": {}
      },
      "id": "2",
      "name": "HTTP Request - RAG API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format response with Answer and Citation Source\nconst ragResponse = $input.first().json;\n\nreturn {\n  json: {\n    status: \"success\",\n    answer: ragResponse.answer,\n    source: ragResponse.source || \"Knowledge Base\",\n    formatted_message: `*Answer:* ${ragResponse.answer}\\n\\n*Source:* ${ragResponse.source || 'N/A'}`,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "3",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "4",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "HTTP Request - RAG API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - RAG API": {
      "main": [
        [
          {
            "node": "Format Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
